<div>
  <!-- Header -->
  <div class="flex items-center justify-between mb-6">
    <h2 class="text-3xl font-headline font-extrabold text-[#e5e1e4]">에피소드 관리</h2>
    <button id="btn-create-episode" class="bg-[#7c3aed] hover:bg-[#6d28d9] text-white text-sm font-semibold px-4 py-2 rounded-lg transition flex items-center gap-2">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
      새 에피소드 생성
    </button>
  </div>

  <!-- 필터 탭 -->
  <div class="flex items-center gap-1 mb-6 bg-[#1b1b1d] rounded-lg p-1 w-fit">
    <button data-filter="all" class="px-4 py-2 text-sm rounded-md bg-[#7c3aed] text-white font-semibold">전체</button>
    <button data-filter="draft" class="px-4 py-2 text-sm rounded-md text-[#ccc3d8] hover:bg-[#2a2a2c] transition">초안</button>
    <button data-filter="approved" class="px-4 py-2 text-sm rounded-md text-[#ccc3d8] hover:bg-[#2a2a2c] transition">승인됨</button>
    <button data-filter="generating" class="px-4 py-2 text-sm rounded-md text-[#ccc3d8] hover:bg-[#2a2a2c] transition">생성 중</button>
    <button data-filter="completed" class="px-4 py-2 text-sm rounded-md text-[#ccc3d8] hover:bg-[#2a2a2c] transition">완료</button>
  </div>

  <!-- 대본 필터 -->
  <div class="flex items-center gap-3 mb-5">
    <label for="script-filter" class="text-sm text-[#ccc3d8] shrink-0">대본 필터:</label>
    <select id="script-filter" class="bg-[#1b1b1d] border border-[#2a2a2c] text-sm text-[#e5e1e4] rounded-lg px-3 py-2 focus:outline-none focus:border-[#7c3aed] transition min-w-[180px]">
      <option value="">전체</option>
    </select>
  </div>

  <!-- 에피소드 테이블 -->
  <div class="bg-[#1b1b1d] rounded-lg border border-[#2a2a2c] overflow-hidden">
    <table class="w-full">
      <thead>
        <tr class="border-b border-[#2a2a2c]">
          <th class="text-left text-xs text-[#ccc3d8]/60 font-medium px-5 py-3 uppercase tracking-wider">에피소드</th>
          <th class="text-left text-xs text-[#ccc3d8]/60 font-medium px-5 py-3 uppercase tracking-wider">제목</th>
          <th class="text-left text-xs text-[#ccc3d8]/60 font-medium px-5 py-3 uppercase tracking-wider">씬 수</th>
          <th class="text-left text-xs text-[#ccc3d8]/60 font-medium px-5 py-3 uppercase tracking-wider">상태</th>
          <th class="text-left text-xs text-[#ccc3d8]/60 font-medium px-5 py-3 uppercase tracking-wider">수정일</th>
          <th class="text-right text-xs text-[#ccc3d8]/60 font-medium px-5 py-3 uppercase tracking-wider">작업</th>
        </tr>
      </thead>
      <tbody id="ep-tbody" class="divide-y divide-[#2a2a2c]"></tbody>
    </table>
  </div>
</div>

<script>
(function () {
  var statusLabels = { draft: '초안', review: '검토', approved: '승인됨', generating: '생성 중', completed: '완료', published: '공개' };
  var statusColors = {
    draft: 'bg-yellow-500/20 text-yellow-400',
    review: 'bg-orange-500/20 text-orange-400',
    approved: 'bg-green-500/20 text-green-400',
    generating: 'bg-blue-500/20 text-blue-400',
    completed: 'bg-emerald-500/20 text-emerald-400',
    published: 'bg-purple-500/20 text-purple-400',
  };

  var allEpisodes = [];
  var currentFilter = 'all';
  var currentScriptId = '';

  function formatDate(dateStr) {
    if (!dateStr) return '--';
    return String(dateStr).slice(0, 10);
  }

  function clearChildren(el) {
    while (el.firstChild) {
      el.removeChild(el.firstChild);
    }
  }

  function buildRow(ep) {
    var epNum = ep.EP_NUMBER != null ? 'EP.' + String(ep.EP_NUMBER).padStart(2, '0') : '--';
    var status = ep.STATUS || 'draft';
    var colorClass = statusColors[status] || 'bg-gray-500/20 text-gray-400';
    var label = statusLabels[status] || status;
    var date = formatDate(ep.CREATED_AT);

    var tr = document.createElement('tr');
    tr.className = 'hover:bg-[#2a2a2c]/50 transition cursor-pointer';
    tr.addEventListener('click', function () {
      window.location.href = '/episodes/' + ep.EP_ID + '/edit';
    });

    // EP number cell
    var tdNum = document.createElement('td');
    tdNum.className = 'px-5 py-4 text-sm font-semibold text-[#d2bbff]';
    tdNum.textContent = epNum;
    tr.appendChild(tdNum);

    // Title cell
    var tdTitle = document.createElement('td');
    tdTitle.className = 'px-5 py-4 text-sm text-[#e5e1e4]';
    tdTitle.textContent = ep.TITLE || '(제목 없음)';
    tr.appendChild(tdTitle);

    // Scene count cell (placeholder — no scene count in API response)
    var tdScenes = document.createElement('td');
    tdScenes.className = 'px-5 py-4 text-sm text-[#ccc3d8]';
    tdScenes.textContent = '-- 씬';
    tr.appendChild(tdScenes);

    // Status badge cell
    var tdStatus = document.createElement('td');
    tdStatus.className = 'px-5 py-4';
    var badge = document.createElement('span');
    badge.className = 'inline-flex items-center gap-1.5 text-[10px] font-semibold px-2.5 py-1 rounded-full ' + colorClass;
    var dot = document.createElement('span');
    var dotColor = colorClass.split(' ').find(function (c) { return c.startsWith('text-'); });
    dot.className = 'w-1.5 h-1.5 rounded-full ' + (dotColor ? dotColor.replace('text-', 'bg-') : '');
    if (status === 'generating') { dot.classList.add('animate-pulse'); }
    badge.appendChild(dot);
    badge.appendChild(document.createTextNode(label));
    tdStatus.appendChild(badge);
    tr.appendChild(tdStatus);

    // Date cell
    var tdDate = document.createElement('td');
    tdDate.className = 'px-5 py-4 text-xs text-[#ccc3d8]';
    tdDate.textContent = date;
    tr.appendChild(tdDate);

    // Edit link cell
    var tdEdit = document.createElement('td');
    tdEdit.className = 'px-5 py-4 text-right';
    var link = document.createElement('a');
    link.href = '/episodes/' + ep.EP_ID + '/edit';
    link.className = 'text-xs text-[#d2bbff] hover:text-white transition';
    link.textContent = '편집';
    link.addEventListener('click', function (e) { e.stopPropagation(); });
    tdEdit.appendChild(link);
    tr.appendChild(tdEdit);

    return tr;
  }

  function renderTable(filter) {
    var tbody = document.getElementById('ep-tbody');
    clearChildren(tbody);

    var filtered = allEpisodes.filter(function (ep) {
      if (filter === 'all') return true;
      return ep.STATUS === filter;
    });

    if (filtered.length === 0) {
      var tr = document.createElement('tr');
      var td = document.createElement('td');
      td.colSpan = 6;
      td.className = 'px-5 py-10 text-center text-sm text-[#ccc3d8]/50';
      td.textContent = '에피소드가 없습니다';
      tr.appendChild(td);
      tbody.appendChild(tr);
      return;
    }

    filtered.forEach(function (ep) {
      tbody.appendChild(buildRow(ep));
    });
  }

  function setActiveFilter(activeBtn) {
    document.querySelectorAll('[data-filter]').forEach(function (btn) {
      btn.className = 'px-4 py-2 text-sm rounded-md text-[#ccc3d8] hover:bg-[#2a2a2c] transition';
    });
    activeBtn.className = 'px-4 py-2 text-sm rounded-md bg-[#7c3aed] text-white font-semibold';
  }

  document.querySelectorAll('[data-filter]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      currentFilter = btn.getAttribute('data-filter');
      setActiveFilter(btn);
      renderTable(currentFilter);
    });
  });

  document.getElementById('btn-create-episode').addEventListener('click', function () {
    window.location.href = '/episodes/new';
  });

  function loadEpisodes(scriptId) {
    var url = '/api/episodes/';
    if (scriptId) { url += '?scriptId=' + encodeURIComponent(scriptId); }
    fetch(url)
      .then(function (res) { return res.json(); })
      .then(function (json) {
        if (json.success && Array.isArray(json.data)) {
          allEpisodes = json.data;
        } else {
          allEpisodes = [];
        }
        renderTable(currentFilter);
      })
      .catch(function (err) {
        console.error('에피소드 목록 로드 실패:', err);
        allEpisodes = [];
        renderTable(currentFilter);
      });
  }

  document.getElementById('script-filter').addEventListener('change', function () {
    currentScriptId = this.value;
    loadEpisodes(currentScriptId);
  });

  // Load master scripts into dropdown
  fetch('/api/master-scripts')
    .then(function (res) { return res.json(); })
    .then(function (json) {
      if (json.success && Array.isArray(json.data)) {
        var select = document.getElementById('script-filter');
        json.data.forEach(function (s) {
          var opt = document.createElement('option');
          opt.value = String(s.SCRIPT_ID);
          opt.textContent = s.TITLE || '(제목 없음)';
          select.appendChild(opt);
        });
      }
    })
    .catch(function (err) {
      console.error('대본 목록 로드 실패:', err);
    });

  loadEpisodes(currentScriptId);
}());
</script>
