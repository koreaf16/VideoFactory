<div>
  <!-- Header -->
  <div class="flex items-center justify-between mb-8">
    <div>
      <a href="/scripts" class="text-xs text-[#ccc3d8] hover:text-[#d2bbff] transition mb-2 inline-block">&larr; 마스터 대본 목록</a>
      <h2 class="text-3xl font-headline font-extrabold text-[#e5e1e4]">새 마스터 대본</h2>
    </div>
  </div>

  <!-- Create form -->
  <div class="bg-[#1b1b1d] rounded-lg border border-[#2a2a2c] p-6 max-w-2xl">
    <div class="space-y-4">
      <!-- Title -->
      <div>
        <label class="block text-sm font-medium text-[#ccc3d8] mb-2">제목 <span class="text-red-400">*</span></label>
        <input id="script-title" type="text" class="w-full bg-[#2a2a2c] border border-[#353437] rounded-lg px-4 py-2.5 text-sm text-[#e5e1e4] focus:outline-none focus:border-[#7c3aed]" placeholder="마스터 대본 제목 입력" required>
      </div>

      <!-- Genre -->
      <div>
        <label class="block text-sm font-medium text-[#ccc3d8] mb-2">장르</label>
        <input id="script-genre" type="text" class="w-full bg-[#2a2a2c] border border-[#353437] rounded-lg px-4 py-2.5 text-sm text-[#e5e1e4] focus:outline-none focus:border-[#7c3aed]" placeholder="예: 판타지, 드라마, 액션">
      </div>

      <!-- Synopsis -->
      <div>
        <label class="block text-sm font-medium text-[#ccc3d8] mb-2">시놉시스</label>
        <textarea id="script-synopsis" rows="4" class="w-full bg-[#2a2a2c] border border-[#353437] rounded-lg px-4 py-2.5 text-sm text-[#e5e1e4] focus:outline-none focus:border-[#7c3aed] resize-none" placeholder="이 마스터 대본의 전체 줄거리를 설명하세요"></textarea>
      </div>

      <!-- World Setting -->
      <div>
        <label class="block text-sm font-medium text-[#ccc3d8] mb-2">세계관 설정</label>
        <textarea id="script-world" rows="4" class="w-full bg-[#2a2a2c] border border-[#353437] rounded-lg px-4 py-2.5 text-sm text-[#e5e1e4] focus:outline-none focus:border-[#7c3aed] resize-none" placeholder="세계관 설정, 배경, 특수한 규칙 등을 설명하세요"></textarea>
      </div>
    </div>

    <!-- Actions -->
    <div class="flex gap-3 justify-end mt-6">
      <a href="/scripts" class="bg-[#353437] hover:bg-[#4a4455] text-[#e5e1e4] text-sm px-5 py-2.5 rounded-lg transition inline-block">취소</a>
      <button id="btn-create" class="bg-[#7c3aed] hover:bg-[#6d28d9] text-white text-sm font-semibold px-5 py-2.5 rounded-lg transition">생성</button>
    </div>

    <!-- Status -->
    <div id="status" class="mt-4 text-sm text-[#ccc3d8]/60 hidden"></div>
  </div>
</div>

<script>
(function () {
  var btn = document.getElementById('btn-create');
  var titleEl = document.getElementById('script-title');
  var genreEl = document.getElementById('script-genre');
  var synopsisEl = document.getElementById('script-synopsis');
  var worldEl = document.getElementById('script-world');
  var statusEl = document.getElementById('status');

  function setStatus(msg, isError) {
    statusEl.textContent = msg;
    statusEl.className = 'mt-4 text-sm ' + (isError ? 'text-red-400' : 'text-green-400');
    statusEl.classList.remove('hidden');
  }

  btn.addEventListener('click', async function () {
    var title = titleEl.value.trim();
    var genre = genreEl.value.trim();
    var synopsis = synopsisEl.value.trim();
    var worldSetting = worldEl.value.trim();

    if (!title) {
      setStatus('제목을 입력하세요', true);
      return;
    }

    btn.disabled = true;
    setStatus('생성 중...', false);

    try {
      var res = await fetch('/api/master-scripts/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          title: title,
          genre: genre || null,
          synopsis: synopsis || null,
          worldSetting: worldSetting || null,
        }),
      });

      var json = await res.json();

      if (json.success && json.scriptId) {
        window.location.href = '/scripts/' + json.scriptId;
      } else {
        setStatus('생성 실패: ' + (json.error || 'Unknown error'), true);
        btn.disabled = false;
      }
    } catch (err) {
      setStatus('오류: ' + (err instanceof Error ? err.message : String(err)), true);
      btn.disabled = false;
    }
  });
}());
</script>
