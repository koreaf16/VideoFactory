<div>
  <!-- Back link -->
  <div class="mb-6">
    <a href="/scripts" class="inline-flex items-center gap-1.5 text-sm text-[#ccc3d8] hover:text-white transition">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
      </svg>
      마스터 대본 목록
    </a>
  </div>

  <!-- 로딩 -->
  <div id="loading" class="text-center py-20 text-[#ccc3d8]">불러오는 중...</div>

  <!-- 대본 상세 -->
  <div id="script-detail" class="hidden">
    <!-- Title -->
    <h2 id="script-title" class="text-3xl font-headline font-extrabold text-[#e5e1e4] mb-6"></h2>

    <!-- Meta card -->
    <div class="bg-[#1b1b1d] rounded-lg border border-[#2a2a2c] p-6 mb-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        <!-- Genre -->
        <div>
          <p class="text-xs text-[#958da1] uppercase tracking-wider mb-1">장르</p>
          <p id="meta-genre" class="text-sm text-[#e5e1e4]"></p>
        </div>
        <!-- Status -->
        <div>
          <p class="text-xs text-[#958da1] uppercase tracking-wider mb-1">상태</p>
          <span id="meta-status-badge" class="inline-flex items-center text-[10px] font-semibold px-2.5 py-1 rounded-full"></span>
        </div>
        <!-- Synopsis -->
        <div class="md:col-span-2">
          <p class="text-xs text-[#958da1] uppercase tracking-wider mb-1">시놉시스</p>
          <p id="meta-synopsis" class="text-sm text-[#e5e1e4] whitespace-pre-wrap"></p>
        </div>
        <!-- World setting -->
        <div class="md:col-span-2">
          <p class="text-xs text-[#958da1] uppercase tracking-wider mb-1">세계관 설정</p>
          <p id="meta-world" class="text-sm text-[#e5e1e4] whitespace-pre-wrap"></p>
        </div>
      </div>
    </div>

    <!-- Episode list -->
    <div class="bg-[#1b1b1d] rounded-lg border border-[#2a2a2c] overflow-hidden">
      <div class="px-5 py-4 border-b border-[#2a2a2c]">
        <h3 class="text-base font-semibold text-[#e5e1e4]">에피소드 목록</h3>
      </div>
      <table class="w-full">
        <thead>
          <tr class="border-b border-[#2a2a2c]">
            <th class="text-left text-xs text-[#ccc3d8]/60 font-medium px-5 py-3 uppercase tracking-wider">에피소드</th>
            <th class="text-left text-xs text-[#ccc3d8]/60 font-medium px-5 py-3 uppercase tracking-wider">제목</th>
            <th class="text-left text-xs text-[#ccc3d8]/60 font-medium px-5 py-3 uppercase tracking-wider">상태</th>
          </tr>
        </thead>
        <tbody id="ep-tbody" class="divide-y divide-[#2a2a2c]"></tbody>
      </table>
    </div>
  </div>

  <!-- Error state -->
  <div id="error-state" class="text-center py-20 text-red-400 hidden">대본을 불러올 수 없습니다.</div>
</div>

<script>
var SCRIPT_ID = <%= scriptId %>;

(function () {
  var statusLabels = { draft: '초안', active: '활성', completed: '완료', archived: '보관됨' };
  var statusColors = {
    draft: 'bg-yellow-500/20 text-yellow-400',
    active: 'bg-green-500/20 text-green-400',
    completed: 'bg-blue-500/20 text-blue-400',
    archived: 'bg-gray-500/20 text-gray-400',
  };
  var epStatusLabels = { draft: '초안', review: '검토', approved: '승인됨', generating: '생성 중', completed: '완료', published: '공개' };
  var epStatusColors = {
    draft: 'bg-yellow-500/20 text-yellow-400',
    review: 'bg-orange-500/20 text-orange-400',
    approved: 'bg-green-500/20 text-green-400',
    generating: 'bg-blue-500/20 text-blue-400',
    completed: 'bg-emerald-500/20 text-emerald-400',
    published: 'bg-purple-500/20 text-purple-400',
  };

  function buildEpRow(ep) {
    var epNum = ep.EP_NUMBER != null ? 'EP.' + String(ep.EP_NUMBER).padStart(2, '0') : '--';
    var status = ep.STATUS || 'draft';
    var colorClass = epStatusColors[status] || 'bg-gray-500/20 text-gray-400';
    var label = epStatusLabels[status] || status;

    var tr = document.createElement('tr');
    tr.className = 'hover:bg-[#2a2a2c]/50 transition cursor-pointer';
    tr.addEventListener('click', function () {
      window.location.href = '/episodes/' + ep.EP_ID + '/edit';
    });

    var tdNum = document.createElement('td');
    tdNum.className = 'px-5 py-4 text-sm font-semibold text-[#d2bbff]';
    tdNum.textContent = epNum;
    tr.appendChild(tdNum);

    var tdTitle = document.createElement('td');
    tdTitle.className = 'px-5 py-4 text-sm text-[#e5e1e4]';
    tdTitle.textContent = ep.TITLE || '(제목 없음)';
    tr.appendChild(tdTitle);

    var tdStatus = document.createElement('td');
    tdStatus.className = 'px-5 py-4';
    var badge = document.createElement('span');
    badge.className = 'inline-flex items-center gap-1.5 text-[10px] font-semibold px-2.5 py-1 rounded-full ' + colorClass;
    var dot = document.createElement('span');
    var dotColor = colorClass.split(' ').find(function (c) { return c.startsWith('text-'); });
    dot.className = 'w-1.5 h-1.5 rounded-full ' + (dotColor ? dotColor.replace('text-', 'bg-') : '');
    badge.appendChild(dot);
    badge.appendChild(document.createTextNode(label));
    tdStatus.appendChild(badge);
    tr.appendChild(tdStatus);

    return tr;
  }

  fetch('/api/master-scripts/' + SCRIPT_ID)
    .then(function (res) { return res.json(); })
    .then(function (json) {
      document.getElementById('loading').classList.add('hidden');
      if (!json.success || !json.data) {
        document.getElementById('error-state').classList.remove('hidden');
        return;
      }
      var s = json.data;

      // Title
      document.getElementById('script-title').textContent = s.TITLE || '(제목 없음)';

      // Meta
      document.getElementById('meta-genre').textContent = s.GENRE || '--';
      document.getElementById('meta-synopsis').textContent = s.SYNOPSIS || '--';
      document.getElementById('meta-world').textContent = s.WORLD_SETTING || '--';

      // Status badge
      var status = s.STATUS || 'draft';
      var colorClass = statusColors[status] || 'bg-gray-500/20 text-gray-400';
      var badgeEl = document.getElementById('meta-status-badge');
      badgeEl.className = 'inline-flex items-center text-[10px] font-semibold px-2.5 py-1 rounded-full ' + colorClass;
      badgeEl.textContent = statusLabels[status] || status;

      // Episodes
      var tbody = document.getElementById('ep-tbody');
      var episodes = Array.isArray(s.episodes) ? s.episodes : [];
      if (episodes.length === 0) {
        var tr = document.createElement('tr');
        var td = document.createElement('td');
        td.colSpan = 3;
        td.className = 'px-5 py-10 text-center text-sm text-[#ccc3d8]/50';
        td.textContent = '아직 에피소드가 없습니다.';
        tr.appendChild(td);
        tbody.appendChild(tr);
      } else {
        episodes.forEach(function (ep) {
          tbody.appendChild(buildEpRow(ep));
        });
      }

      document.getElementById('script-detail').classList.remove('hidden');
    })
    .catch(function (err) {
      console.error('대본 상세 로드 실패:', err);
      document.getElementById('loading').classList.add('hidden');
      document.getElementById('error-state').classList.remove('hidden');
    });
}());
</script>
