<div>
  <!-- Header -->
  <div class="flex items-center justify-between mb-6">
    <div>
      <h2 class="text-3xl font-headline font-extrabold text-[#e5e1e4]">캐릭터 후보 선택</h2>
      <p class="text-xs text-[#ccc3d8] mt-1">작업 ID: <span class="text-[#d2bbff]"><%= jobId %></span></p>
    </div>
    <a href="/characters" class="bg-[#353437] hover:bg-[#4a4455] text-[#e5e1e4] text-sm px-4 py-2 rounded-lg transition">목록으로</a>
  </div>

  <!-- 진행 상태 -->
  <div id="progress-area" class="mb-6">
    <div class="flex items-center gap-3 mb-2">
      <span id="progress-label" class="text-sm text-[#ccc3d8]">생성 중...</span>
      <span id="progress-count" class="text-sm text-[#d2bbff] font-semibold">0/0</span>
    </div>
    <div class="w-full bg-[#353437] rounded-full h-2">
      <div id="progress-bar" class="bg-[#7c3aed] h-2 rounded-full transition-all" style="width:0%"></div>
    </div>
  </div>

  <!-- 정보 -->
  <div id="controls" class="flex items-center justify-between mb-4 hidden">
    <p class="text-sm text-[#ccc3d8]">전체 <span id="total-count" class="text-[#d2bbff] font-semibold">0</span>개 후보 — 이미지를 클릭하면 크게 보고 확정할 수 있습니다</p>
  </div>

  <!-- 후보 그리드 -->
  <div id="cand-grid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3 mb-20"></div>

  <!-- 이미지 상세 모달 -->
  <div id="img-modal" class="fixed inset-0 bg-black/90 z-50 flex items-center justify-center hidden">
    <div class="relative max-w-[85vw] max-h-[90vh] flex flex-col items-center">
      <img id="img-modal-src" class="max-w-full max-h-[75vh] rounded-lg shadow-2xl" src="" alt="">
      <div class="flex gap-3 mt-4">
        <button id="modal-close" class="bg-[#353437] hover:bg-[#4a4455] text-[#e5e1e4] text-sm px-6 py-2.5 rounded-lg transition">닫기</button>
        <button id="modal-anchor" class="bg-[#7c3aed] hover:bg-[#6d28d9] text-white text-sm font-semibold px-6 py-2.5 rounded-lg transition">이 이미지로 앵커 확정</button>
      </div>
      <p id="modal-info" class="text-xs text-[#ccc3d8] mt-2"></p>
    </div>
  </div>

  <!-- 하단 고정 바 -->
  <div id="bottom-bar" class="fixed bottom-0 left-64 right-0 bg-[#1b1b1d] border-t border-[#2a2a2c] px-8 py-3 flex items-center justify-between z-30 hidden">
    <p class="text-sm text-[#ccc3d8]">총 <span id="bottom-total" class="text-[#d2bbff] font-bold">0</span>개 후보</p>
    <button id="btn-more" class="bg-[#7c3aed] hover:bg-[#6d28d9] text-white text-sm font-semibold px-5 py-2.5 rounded-lg transition">+ 10개 더 생성</button>
  </div>
</div>

<script src="/js/characters.js"></script>
<script>
(function() {
  var JOB_ID = '<%= jobId %>';
  var pollTimer = null;
  var candidates = [];
  var charId = '';
  var selectedCandidateId = null;

  function createCard(c) {
    var card = document.createElement('div');
    card.className = 'bg-[#2a2a2c] rounded-lg overflow-hidden cursor-pointer group hover:ring-2 hover:ring-[#7c3aed] transition';
    if (c.isAnchor) card.className += ' ring-2 ring-yellow-400';

    var imgWrap = document.createElement('div');
    imgWrap.className = 'aspect-[3/4] bg-[#353437] flex items-center justify-center relative';

    if (c.imagePath) {
      var thumbUrl = pathToUrl(c.imagePath).replace(/([^\/]+)\.png$/, 'thumb_$1.png');
      var img = document.createElement('img');
      img.src = thumbUrl;
      img.alt = 'candidate';
      img.className = 'w-full h-full object-cover';
      img.loading = 'lazy';
      imgWrap.appendChild(img);
    }

    if (c.isAnchor) {
      var anchorBadge = document.createElement('span');
      anchorBadge.className = 'absolute top-2 left-2 text-[9px] font-bold px-2 py-0.5 rounded bg-yellow-400 text-black';
      anchorBadge.textContent = '앵커';
      imgWrap.appendChild(anchorBadge);
    }

    card.appendChild(imgWrap);

    var info = document.createElement('div');
    info.className = 'p-2';
    var seedEl = document.createElement('span');
    seedEl.className = 'text-[10px] text-[#ccc3d8]/60';
    seedEl.textContent = '#' + (c.seed || '-');
    info.appendChild(seedEl);
    card.appendChild(info);

    card.addEventListener('click', function() {
      if (c.imagePath) openModal(c);
    });

    return card;
  }

  function openModal(c) {
    selectedCandidateId = c.candidateId;
    document.getElementById('img-modal-src').src = pathToUrl(c.imagePath);
    document.getElementById('modal-info').textContent = 'seed: ' + c.seed + (c.grade ? ' | 등급: ' + c.grade : '');
    document.getElementById('img-modal').classList.remove('hidden');
    var anchorBtn = document.getElementById('modal-anchor');
    if (c.isAnchor) {
      anchorBtn.textContent = '이미 앵커로 확정됨';
      anchorBtn.disabled = true;
      anchorBtn.className = 'bg-[#353437] text-[#ccc3d8] text-sm px-6 py-2.5 rounded-lg cursor-not-allowed';
    } else {
      anchorBtn.textContent = '이 이미지로 앵커 확정';
      anchorBtn.disabled = false;
      anchorBtn.className = 'bg-[#7c3aed] hover:bg-[#6d28d9] text-white text-sm font-semibold px-6 py-2.5 rounded-lg transition';
    }
  }

  document.getElementById('modal-close').addEventListener('click', function() {
    document.getElementById('img-modal').classList.add('hidden');
  });
  document.getElementById('img-modal').addEventListener('click', function(e) {
    if (e.target === this) this.classList.add('hidden');
  });

  document.getElementById('modal-anchor').addEventListener('click', async function() {
    if (!selectedCandidateId) return;
    var btn = this; btn.disabled = true; btn.textContent = '확정 중...';
    try {
      var res = await fetch('/api/characters/candidates/' + JOB_ID + '/anchor', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ anchorCandidateId: selectedCandidateId }),
      });
      var json = await res.json();
      if (json.success) {
        if (json.derivativeJobId) {
          window.location.href = '/characters/derivatives/' + json.derivativeJobId;
        } else {
          alert('앵커가 확정되었습니다!');
          document.getElementById('img-modal').classList.add('hidden');
          pollStatus();
        }
      } else {
        alert('실패: ' + (json.error || ''));
        btn.disabled = false; btn.textContent = '이 이미지로 앵커 확정';
      }
    } catch (err) {
      alert('요청 실패: ' + err.message);
      btn.disabled = false; btn.textContent = '이 이미지로 앵커 확정';
    }
  });

  function renderCandidates() {
    var grid = document.getElementById('cand-grid');
    grid.textContent = '';
    candidates.forEach(function(c) { grid.appendChild(createCard(c)); });
    document.getElementById('total-count').textContent = candidates.length;
    document.getElementById('bottom-total').textContent = candidates.length;
  }

  async function pollStatus() {
    try {
      var res = await fetch('/api/characters/candidates/' + JOB_ID);
      var json = await res.json();
      if (!json.success) return;
      var d = json.data;
      charId = d.charId;
      candidates = d.candidates || [];

      var pct = d.total > 0 ? Math.round((d.completed / d.total) * 100) : 0;
      document.getElementById('progress-bar').style.width = pct + '%';
      document.getElementById('progress-count').textContent = d.completed + '/' + d.total;

      if (d.status === 'completed' || d.status === 'failed') {
        clearInterval(pollTimer);
        document.getElementById('progress-area').classList.add('hidden');
        document.getElementById('controls').classList.remove('hidden');
        document.getElementById('bottom-bar').classList.remove('hidden');
      }
      renderCandidates();
    } catch (err) { /* silent */ }
  }

  document.getElementById('btn-more').addEventListener('click', async function() {
    if (!charId) return;
    var btn = this; btn.disabled = true; btn.textContent = '생성 중...';
    try {
      var res = await fetch('/api/characters/generate-candidates', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ charId: charId, count: 10 }),
      });
      var json = await res.json();
      if (json.success && json.jobId) {
        window.location.href = '/characters/candidates/' + json.jobId;
      } else {
        alert('실패: ' + (json.error || ''));
        btn.disabled = false; btn.textContent = '+ 10개 더 생성';
      }
    } catch (err) {
      alert('요청 실패: ' + err.message);
      btn.disabled = false; btn.textContent = '+ 10개 더 생성';
    }
  });

  pollStatus();
  pollTimer = setInterval(pollStatus, 3000);
})();
</script>
