<div>
  <!-- Header -->
  <div class="flex items-center justify-between mb-6">
    <div>
      <h2 class="text-3xl font-headline font-extrabold text-[#e5e1e4]">파생 이미지 생성</h2>
      <p class="text-xs text-[#ccc3d8] mt-1">작업 ID: <span class="text-[#d2bbff]"><%= jobId %></span></p>
    </div>
    <a href="/characters" class="bg-[#353437] hover:bg-[#4a4455] text-[#e5e1e4] text-sm px-4 py-2 rounded-lg transition">목록으로</a>
  </div>

  <!-- 실시간 상태 카드 -->
  <div id="status-card" class="bg-[#2a2a2c] rounded-xl p-6 mb-6 border border-[#353437]">
    <div class="flex items-center gap-4 mb-4">
      <div id="status-icon" class="w-10 h-10 rounded-full bg-[#7c3aed] flex items-center justify-center">
        <span id="spinner-svg" class="animate-spin text-white text-lg">&#9696;</span>
      </div>
      <div>
        <p id="status-text" class="text-lg font-semibold text-[#e5e1e4]">준비 중...</p>
        <p id="status-detail" class="text-sm text-[#ccc3d8]">유사 얼굴 30장 확보까지 자동 반복 생성</p>
      </div>
    </div>

    <div class="mb-3">
      <div class="flex justify-between text-xs text-[#ccc3d8] mb-1">
        <span id="progress-label">대기 중</span>
        <span id="progress-pct">0%</span>
      </div>
      <div class="w-full bg-[#353437] rounded-full h-3">
        <div id="progress-bar" class="bg-gradient-to-r from-[#7c3aed] to-[#a855f7] h-3 rounded-full transition-all duration-500" style="width:0%"></div>
      </div>
    </div>

    <!-- 통계 -->
    <div id="stats-row" class="mt-4 grid grid-cols-4 gap-3 text-center">
      <div class="bg-[#1b1b1d] rounded-lg p-3">
        <p class="text-lg font-bold text-[#4ade80]" id="stat-similar">0</p>
        <p class="text-[10px] text-[#ccc3d8]">유사 확보</p>
      </div>
      <div class="bg-[#1b1b1d] rounded-lg p-3">
        <p class="text-lg font-bold text-[#d2bbff]" id="stat-generated">0</p>
        <p class="text-[10px] text-[#ccc3d8]">총 생성</p>
      </div>
      <div class="bg-[#1b1b1d] rounded-lg p-3">
        <p class="text-lg font-bold text-[#f87171]" id="stat-deleted">0</p>
        <p class="text-[10px] text-[#ccc3d8]">삭제</p>
      </div>
      <div class="bg-[#1b1b1d] rounded-lg p-3">
        <p class="text-lg font-bold text-[#fbbf24]" id="stat-batch">0</p>
        <p class="text-[10px] text-[#ccc3d8]">배치</p>
      </div>
    </div>

    <div id="step-log" class="mt-4 max-h-40 overflow-y-auto bg-[#1b1b1d] rounded-lg p-3 text-xs font-mono text-[#ccc3d8] space-y-1"></div>

    <!-- 액션 버튼 -->
    <div id="action-buttons" class="mt-4 flex gap-3">
      <button id="stop-btn" class="bg-red-600 hover:bg-red-700 text-white text-sm px-4 py-2 rounded-lg transition">
        중지
      </button>
      <a id="btn-gallery" href="#" class="bg-green-500/20 hover:bg-green-500/40 text-green-400 text-sm font-semibold px-4 py-2 rounded-lg transition hidden">갤러리 보기</a>
      <a id="btn-lora" href="/characters/lora-dataset" class="bg-[#7c3aed] hover:bg-[#6d28d9] text-white text-sm font-semibold px-4 py-2 rounded-lg transition hidden">LoRA 학습 시작</a>
      <button id="btn-select-all" class="bg-[#353437] hover:bg-[#4a4455] text-[#e5e1e4] text-sm font-semibold px-4 py-2 rounded-lg transition hidden">전체 선택</button>
      <button id="btn-approve" data-char-id="" class="bg-green-600 hover:bg-green-700 text-white text-sm font-semibold px-4 py-2 rounded-lg transition hidden">선택 승인</button>
      <button id="btn-approve-all" class="bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold px-4 py-2 rounded-lg transition hidden">전체 승인</button>
    </div>
  </div>

  <!-- 결과 그리드 -->
  <div id="results-area" class="hidden mb-24">
    <h3 class="text-xl font-bold text-[#e5e1e4] mb-4">생성된 파생 이미지</h3>
    <p class="text-sm text-[#ccc3d8] mb-4">이미지를 클릭하면 크게 볼 수 있습니다</p>
    <div id="result-grid" class="flex flex-wrap gap-3"></div>
  </div>

  <!-- 이미지 모달 -->
  <div id="img-modal" class="fixed inset-0 bg-black/90 z-50 flex items-center justify-center hidden">
    <div class="relative max-w-[85vw] max-h-[90vh] flex flex-col items-center">
      <img id="img-modal-src" class="max-w-full max-h-[65vh] rounded-lg shadow-2xl" src="" alt="">
      <p id="img-modal-label" class="text-sm text-[#d2bbff] font-semibold mt-3"></p>
      <p id="img-modal-prompt" class="text-xs text-[#ccc3d8] mt-1 max-w-xl text-center"></p>

      <!-- 수정 프롬프트 입력 -->
      <div class="mt-4 w-full max-w-xl">
        <p class="text-xs text-[#ccc3d8] mb-1">수정 지시 (선택)</p>
        <textarea
          id="img-modal-modify"
          class="w-full bg-[#1b1b1d] border border-[#353437] text-[#e5e1e4] text-sm rounded-lg px-3 py-2 resize-none focus:outline-none focus:border-[#7c3aed]"
          rows="2"
          placeholder="예: 눈을 더 크게 만들어줘, 배경을 파란색으로 바꿔줘..."
        ></textarea>
      </div>

      <div class="mt-3 flex gap-3">
        <button id="modal-regen-btn" class="bg-[#7c3aed] hover:bg-[#6d28d9] text-white text-sm px-5 py-2 rounded-lg transition font-semibold">재생성</button>
        <button id="modal-close" class="bg-[#353437] hover:bg-[#4a4455] text-[#e5e1e4] text-sm px-6 py-2 rounded-lg transition">닫기</button>
      </div>
    </div>
  </div>
</div>

<script src="/js/characters.js"></script>
<script src="/js/approval.js"></script>
<script>
(function() {
  var JOB_ID = '<%= jobId %>';
  var logEl = document.getElementById('step-log');

  function addLog(msg) {
    var line = document.createElement('div');
    line.textContent = '[' + new Date().toLocaleTimeString() + '] ' + msg;
    logEl.appendChild(line);
    if (logEl.children.length > 50) logEl.removeChild(logEl.firstChild);
    logEl.scrollTop = logEl.scrollHeight;
  }

  function createResultCard(r) {
    var card = document.createElement('div');
    card.className = 'w-[150px] flex-shrink-0 bg-[#2a2a2c] rounded-lg overflow-hidden cursor-pointer group hover:ring-2 hover:ring-[#7c3aed] transition';
    card.dataset.label = r.label;
    card.dataset.refId = String(r.refId ?? '');
    card.dataset.imagePath = r.imagePath || '';
    card.dataset.prompt = r.prompt || '';

    var imgWrap = document.createElement('div');
    imgWrap.className = 'w-[150px] h-[200px] bg-[#353437] flex items-center justify-center';

    if (r.imagePath) {
      var img = document.createElement('img');
      img.src = thumbUrl(r.imagePath);
      img.alt = r.label;
      img.className = 'w-full h-full object-cover';
      img.loading = 'lazy';
      imgWrap.appendChild(img);
    }
    card.appendChild(imgWrap);

    var info = document.createElement('div');
    info.className = 'p-2';
    var labelEl = document.createElement('p');
    labelEl.className = 'text-xs font-semibold text-[#d2bbff]';
    labelEl.textContent = r.label;
    info.appendChild(labelEl);
    if (r.distance !== undefined && r.distance !== null) {
      var distEl = document.createElement('p');
      distEl.className = 'text-[10px] text-[#4ade80]';
      distEl.textContent = '유사도: ' + (100 - Math.round(r.distance * 100)) + '%';
      info.appendChild(distEl);
    }
    card.appendChild(info);

    card.addEventListener('click', function() {
      var imgPath = card.dataset.imagePath;
      if (imgPath) {
        currentModalLabel = card.dataset.label;
        document.getElementById('img-modal-src').src = pathToUrl(imgPath);
        document.getElementById('img-modal-label').textContent = card.dataset.label;
        document.getElementById('img-modal-prompt').textContent = card.dataset.prompt || '';
        document.getElementById('img-modal-modify').value = '';
        document.getElementById('img-modal').classList.remove('hidden');
      }
    });

    return card;
  }

  function renderResults(results) {
    var grid = document.getElementById('result-grid');
    grid.textContent = '';
    results.forEach(function(r) { grid.appendChild(createResultCard(r)); });
    if (results.length > 0) document.getElementById('results-area').classList.remove('hidden');
  }

  var isStopping = false;
  var currentModalLabel = '';

  function updateStatus(data) {
    var pct = data.total > 0 ? Math.round((data.completed / data.total) * 100) : 0;
    document.getElementById('progress-bar').style.width = pct + '%';
    document.getElementById('progress-pct').textContent = pct + '%';
    document.getElementById('progress-label').textContent = data.currentStep || '대기 중';
    document.getElementById('status-text').textContent = data.currentStep || '준비 중...';
    document.getElementById('status-detail').textContent = '유사 ' + data.completed + '/' + data.total + '장 확보';

    // 통계 업데이트
    document.getElementById('stat-similar').textContent = data.completed || 0;
    document.getElementById('stat-generated').textContent = data.generated || 0;
    document.getElementById('stat-deleted').textContent = data.deleted || 0;
    document.getElementById('stat-batch').textContent = data.batch || 0;

    addLog(data.currentStep || data.status);
    if (data.results) renderResults(data.results);

    var stopBtn = document.getElementById('stop-btn');
    if (data.status === 'completed') {
      document.getElementById('status-icon').className = 'w-10 h-10 rounded-full bg-green-900/50 flex items-center justify-center';
      document.getElementById('spinner-svg').className = '';
      document.getElementById('spinner-svg').textContent = '\u2714';
      document.getElementById('spinner-svg').style.color = '#4ade80';
      addLog('전체 파생 이미지 생성 완료!');
      stopBtn.disabled = true;
      stopBtn.className = 'bg-gray-600 text-white text-sm px-4 py-2 rounded-lg cursor-not-allowed opacity-50';
      if (data.charId) {
        var galleryBtn = document.getElementById('btn-gallery');
        galleryBtn.href = '/characters/' + encodeURIComponent(data.charId) + '/gallery';
        galleryBtn.classList.remove('hidden');
        document.getElementById('btn-lora').classList.remove('hidden');
        document.getElementById('btn-approve').classList.remove('hidden');
        document.getElementById('btn-approve').dataset.charId = data.charId;
        document.getElementById('btn-approve-all').classList.remove('hidden');
      }
    } else if (data.status === 'stopped') {
      document.getElementById('status-icon').className = 'w-10 h-10 rounded-full bg-yellow-900/50 flex items-center justify-center';
      document.getElementById('spinner-svg').className = '';
      document.getElementById('spinner-svg').textContent = '\u26A0';
      document.getElementById('spinner-svg').style.color = '#fbbf24';
      addLog('생성이 중단되었습니다');
      stopBtn.disabled = true;
      stopBtn.className = 'bg-gray-600 text-white text-sm px-4 py-2 rounded-lg cursor-not-allowed opacity-50';
    } else if (data.status === 'failed') {
      document.getElementById('status-icon').className = 'w-10 h-10 rounded-full bg-red-900/50 flex items-center justify-center';
      document.getElementById('spinner-svg').className = '';
      document.getElementById('spinner-svg').textContent = '\u2718';
      document.getElementById('spinner-svg').style.color = '#f87171';
      addLog('생성 실패');
      stopBtn.disabled = true;
      stopBtn.className = 'bg-gray-600 text-white text-sm px-4 py-2 rounded-lg cursor-not-allowed opacity-50';
    }
  }

  // 중지 버튼 클릭 이벤트
  document.getElementById('stop-btn').addEventListener('click', function() {
    if (isStopping || this.disabled) return;
    isStopping = true;
    this.disabled = true;
    this.textContent = '중지 중...';
    this.className = 'bg-gray-600 text-white text-sm px-4 py-2 rounded-lg cursor-not-allowed opacity-50';

    fetch('/api/characters/derivatives/' + JOB_ID + '/stop', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' }
    })
    .then(function(res) { return res.json(); })
    .then(function(data) {
      if (data.success) {
        addLog('중지 요청 완료');
      } else {
        addLog('중지 요청 실패: ' + (data.error || '알 수 없는 오류'));
        isStopping = false;
        document.getElementById('stop-btn').disabled = false;
        document.getElementById('stop-btn').textContent = '중지';
        document.getElementById('stop-btn').className = 'bg-red-600 hover:bg-red-700 text-white text-sm px-4 py-2 rounded-lg transition';
      }
    })
    .catch(function(err) {
      addLog('중지 요청 실패: ' + err.message);
      isStopping = false;
      document.getElementById('stop-btn').disabled = false;
      document.getElementById('stop-btn').textContent = '중지';
      document.getElementById('stop-btn').className = 'bg-red-600 hover:bg-red-700 text-white text-sm px-4 py-2 rounded-lg transition';
    });
  });

  addLog('서버 연결 중...');
  var evtSource = new EventSource('/api/characters/derivatives/' + JOB_ID + '/stream');

  evtSource.onmessage = function(e) {
    try {
      var data = JSON.parse(e.data);
      updateStatus(data);
      if (data.status === 'completed' || data.status === 'failed' || data.status === 'stopped') evtSource.close();
    } catch (err) { /* ignore */ }
  };

  evtSource.onerror = function() { addLog('연결 끊김 - 재시도 중...'); };

  // 선택 승인 버튼 토글
  var approveActive = false;
  document.getElementById('btn-approve').addEventListener('click', function() {
    var grid = document.getElementById('result-grid');
    var charId = this.dataset.charId;
    var selectAllBtn = document.getElementById('btn-select-all');

    if (!approveActive) {
      approveActive = true;
      this.textContent = '선택 종료';
      this.className = this.className.replace('bg-green-600 hover:bg-green-700', 'bg-gray-600 hover:bg-gray-700');
      selectAllBtn.classList.remove('hidden');

      ApprovalMode.init(grid, {
        charId: charId,
        onApproved: function(refIds, approved) {
          addLog((approved ? '승인' : '승인 취소') + ' 완료: ' + refIds.length + '장');
        },
      });
    } else {
      approveActive = false;
      this.textContent = '선택 승인';
      this.className = this.className.replace('bg-gray-600 hover:bg-gray-700', 'bg-green-600 hover:bg-green-700');
      selectAllBtn.classList.add('hidden');
      ApprovalMode.destroy();
    }
  });

  // 전체 선택 버튼
  document.getElementById('btn-select-all').addEventListener('click', function() {
    if (approveActive && typeof ApprovalMode !== 'undefined') {
      ApprovalMode.selectAll();
    }
  });

  // 전체 승인 버튼
  document.getElementById('btn-approve-all').addEventListener('click', function() {
    var charId = document.getElementById('btn-approve').dataset.charId;
    if (!charId) return;

    var grid = document.getElementById('result-grid');
    var cards = grid.querySelectorAll('[data-ref-id]');
    var refIds = [];
    cards.forEach(function(card) {
      var rid = card.dataset.refId;
      if (rid) refIds.push(Number(rid));
    });

    if (refIds.length === 0) {
      alert('승인할 이미지가 없습니다.');
      return;
    }

    if (!confirm(refIds.length + '장의 이미지를 모두 승인하시겠습니까?')) return;

    var btn = this;
    var originalText = btn.textContent;
    btn.disabled = true;
    btn.textContent = '처리 중...';

    fetch('/api/characters/' + encodeURIComponent(charId) + '/ref-images/approve-batch', {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ refIds: refIds, approved: true }),
    })
    .then(function(res) { return res.json(); })
    .then(function(data) {
      if (data.success) {
        addLog('전체 승인 완료: ' + data.updated + '장');
        if (typeof showToast === 'function') showToast('전체 승인 완료', 'success');
      } else {
        addLog('전체 승인 실패: ' + (data.error || '오류'));
      }
    })
    .catch(function(err) {
      addLog('전체 승인 실패: ' + err.message);
    })
    .finally(function() {
      btn.disabled = false;
      btn.textContent = originalText;
    });
  });

  document.getElementById('modal-close').addEventListener('click', function() {
    document.getElementById('img-modal').classList.add('hidden');
  });
  document.getElementById('modal-regen-btn').addEventListener('click', function() {
    var label = currentModalLabel;
    var modifyPrompt = document.getElementById('img-modal-modify').value;
    if (!label) return;

    document.getElementById('img-modal').classList.add('hidden');

    var card = document.querySelector('[data-label="' + CSS.escape(label) + '"]');
    var overlayId = 'regen-overlay-' + label.replace(/\W/g, '_');
    if (card) {
      var overlay = document.createElement('div');
      overlay.id = overlayId;
      overlay.className = 'absolute inset-0 bg-black/70 flex items-center justify-center rounded-lg z-10';
      var spinner = document.createElement('span');
      spinner.className = 'animate-spin text-white text-2xl';
      spinner.textContent = '\u25D6';
      overlay.appendChild(spinner);
      card.style.position = 'relative';
      card.appendChild(overlay);
    }

    fetch('/api/characters/derivatives/' + JOB_ID + '/regenerate', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ label: label, modifyPrompt: modifyPrompt })
    })
    .then(function(res) { return res.json(); })
    .then(function(data) {
      var ov = document.getElementById(overlayId);
      if (ov) ov.remove();
      if (data.success && data.result && card) {
        card.dataset.imagePath = data.result.imagePath;
        card.dataset.prompt = data.result.prompt || '';
        var img = card.querySelector('img');
        if (img) {
          img.src = thumbUrl(data.result.imagePath) + '?t=' + Date.now();
        }
        addLog(label + ' 재생성 완료');
      } else {
        addLog('재생성 실패: ' + (data.error || data.message || '알 수 없는 오류'));
      }
    })
    .catch(function(err) {
      var ov = document.getElementById(overlayId);
      if (ov) ov.remove();
      addLog('재생성 실패: ' + err.message);
    });
  });
  document.getElementById('img-modal').addEventListener('click', function(e) {
    if (e.target === this) this.classList.add('hidden');
  });
})();
</script>
