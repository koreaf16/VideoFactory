<div>
  <!-- Header -->
  <div class="flex items-center justify-between mb-8">
    <h2 class="text-3xl font-headline font-extrabold text-[#e5e1e4]">캐릭터 관리</h2>
    <button id="btn-generate-top" class="bg-[#7c3aed] hover:bg-[#6d28d9] text-white text-sm font-semibold px-4 py-2 rounded-lg transition flex items-center gap-2">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
      새 캐릭터 후보 생성
    </button>
  </div>

  <!-- 로딩 -->
  <div id="loading" class="text-center py-20 text-[#ccc3d8]">불러오는 중...</div>

  <!-- 캐릭터 카드 그리드 -->
  <div id="char-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 hidden"></div>

  <!-- 빈 상태 -->
  <div id="empty-state" class="text-center py-20 text-[#ccc3d8] hidden">등록된 캐릭터가 없습니다.</div>

  <!-- 후보 생성 모달 -->
  <div id="gen-modal" class="fixed inset-0 bg-black/60 z-50 flex items-center justify-center hidden">
    <div class="bg-[#2a2a2c] rounded-xl p-6 w-96 shadow-xl">
      <h3 class="text-lg font-semibold text-[#e5e1e4] mb-4">후보 이미지 생성</h3>
      <div class="mb-4">
        <label class="block text-sm text-[#ccc3d8] mb-1">캐릭터</label>
        <select id="modal-char-select" class="w-full bg-[#353437] border border-[#4a4455] rounded-lg px-3 py-2 text-sm text-[#e5e1e4] focus:outline-none focus:border-[#7c3aed]"></select>
      </div>
      <div class="mb-4">
        <label class="block text-sm text-[#ccc3d8] mb-1">프롬프트 (직접 입력)</label>
        <textarea id="modal-prompt" rows="4" placeholder="예: photorealistic, Korean high school girl, long dark brown hair with bangs, brown eyes, navy hoodie, selfie pose, bright smile, outdoor, golden hour..." class="w-full bg-[#353437] border border-[#4a4455] rounded-lg px-3 py-2 text-sm text-[#e5e1e4] placeholder-[#958da1] focus:outline-none focus:border-[#7c3aed] resize-none"></textarea>
        <p class="text-xs text-[#958da1] mt-1">비워두면 캐릭터 프로필에서 자동 생성</p>
      </div>
      <div class="mb-6">
        <label class="block text-sm text-[#ccc3d8] mb-1">생성 개수</label>
        <input id="modal-count" type="number" value="10" min="1" max="50" class="w-full bg-[#353437] border border-[#4a4455] rounded-lg px-3 py-2 text-sm text-[#e5e1e4] focus:outline-none focus:border-[#7c3aed]">
      </div>
      <div class="flex gap-3 justify-end">
        <button id="modal-cancel" class="bg-[#353437] hover:bg-[#4a4455] text-[#e5e1e4] text-sm px-4 py-2 rounded-lg transition">취소</button>
        <button id="modal-submit" class="bg-[#7c3aed] hover:bg-[#6d28d9] text-white text-sm font-semibold px-4 py-2 rounded-lg transition">생성 시작</button>
      </div>
    </div>
  </div>
</div>

<script src="/js/characters.js"></script>
<script>
(function() {
  var grid = document.getElementById('char-grid');
  var loading = document.getElementById('loading');
  var emptyState = document.getElementById('empty-state');
  var modal = document.getElementById('gen-modal');
  var charSelect = document.getElementById('modal-char-select');
  var countInput = document.getElementById('modal-count');
  var characters = [];

  var statusMap = { protagonist: '주인공', antagonist: '적', supporting: '조연', guide: '가이드', anchor_set: '확정', candidate: '후보 선정 중' };
  var statusColorMap = { anchor_set: 'bg-green-500/20 text-green-400', candidate: 'bg-yellow-500/20 text-yellow-400' };

  // 캐릭터별 프롬프트 localStorage 관리
  function savePrompt(charId, prompt) {
    if (!prompt) return;
    try { localStorage.setItem('prompt_' + charId, prompt); } catch(e) {}
  }
  function loadPrompt(charId) {
    try { return localStorage.getItem('prompt_' + charId) || ''; } catch(e) { return ''; }
  }

  var personSvg = '<svg class="w-16 h-16 text-[#ccc3d8]/20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>';

  function createCard(c) {
    var card = document.createElement('div');
    card.className = 'bg-[#2a2a2c] rounded-lg overflow-hidden group';

    var thumbArea = document.createElement('div');
    thumbArea.className = 'aspect-[4/3] bg-[#353437] flex items-center justify-center';
    /* Static SVG placeholder - no user content */
    thumbArea.innerHTML = personSvg;
    card.appendChild(thumbArea);

    var body = document.createElement('div');
    body.className = 'p-4';

    var header = document.createElement('div');
    header.className = 'flex items-center justify-between mb-2';
    var nameEl = document.createElement('h3');
    nameEl.className = 'text-base font-semibold text-[#e5e1e4]';
    nameEl.textContent = c.NAME;
    var roleEl = document.createElement('span');
    roleEl.className = 'text-[10px] bg-[#7c3aed]/20 text-[#d2bbff] px-2 py-0.5 rounded-full';
    roleEl.textContent = c.ROLE || '역할 없음';
    header.appendChild(nameEl);
    header.appendChild(roleEl);
    body.appendChild(header);

    var status = statusMap[c.CHAR_TYPE] || c.CHAR_TYPE || '미정';
    var statusCls = statusColorMap[c.CHAR_TYPE] || 'bg-blue-500/20 text-blue-400';
    var badge = document.createElement('span');
    badge.className = 'inline-block text-[10px] ' + statusCls + ' px-2 py-0.5 rounded-full mb-3';
    badge.textContent = status;
    body.appendChild(badge);

    var actions = document.createElement('div');
    actions.className = 'flex gap-2 mt-4';

    var genBtn = document.createElement('button');
    genBtn.className = 'flex-1 bg-[#7c3aed]/20 hover:bg-[#7c3aed]/40 text-[#d2bbff] text-xs py-2 rounded-lg transition font-semibold';
    genBtn.textContent = '후보 생성';
    genBtn.addEventListener('click', function() { openGenModal(c.CHAR_ID); });
    actions.appendChild(genBtn);

    // 기존 후보가 있으면 "기존 후보 보기" 버튼 표시
    if (c.LATEST_JOB_ID) {
      var viewBtn = document.createElement('a');
      viewBtn.href = '/characters/candidates/' + encodeURIComponent(c.LATEST_JOB_ID);
      viewBtn.className = 'flex-1 bg-[#353437] hover:bg-[#4a4455] text-[#e5e1e4] text-xs py-2 rounded-lg transition text-center';
      viewBtn.textContent = '기존 후보 보기';
      actions.appendChild(viewBtn);
    }

    body.appendChild(actions);
    card.appendChild(body);
    return card;
  }

  function populateSelect(preselect) {
    charSelect.textContent = '';
    characters.forEach(function(c) {
      var opt = document.createElement('option');
      opt.value = c.CHAR_ID;
      opt.textContent = c.NAME + ' (' + c.CHAR_ID + ')';
      if (c.CHAR_ID === preselect) opt.selected = true;
      charSelect.appendChild(opt);
    });
  }

  function openGenModal(charId) {
    populateSelect(charId);
    countInput.value = '10';
    // 저장된 프롬프트 불러오기
    var saved = loadPrompt(charId);
    document.getElementById('modal-prompt').value = saved;
    modal.classList.remove('hidden');
  }

  async function loadCharacters() {
    try {
      var res = await fetch('/api/characters/');
      var json = await res.json();
      characters = json.data || [];
      loading.classList.add('hidden');
      if (characters.length === 0) { emptyState.classList.remove('hidden'); return; }
      grid.classList.remove('hidden');
      grid.textContent = '';
      characters.forEach(function(c) { grid.appendChild(createCard(c)); });
      populateSelect();
    } catch (err) {
      loading.textContent = '캐릭터 목록을 불러오지 못했습니다.';
    }
  }

  // 캐릭터 선택 변경 시 저장된 프롬프트 불러오기
  charSelect.addEventListener('change', function() {
    document.getElementById('modal-prompt').value = loadPrompt(charSelect.value);
  });

  document.getElementById('btn-generate-top').addEventListener('click', function() {
    populateSelect(); countInput.value = '10';
    document.getElementById('modal-prompt').value = loadPrompt(charSelect.value);
    modal.classList.remove('hidden');
  });
  document.getElementById('modal-cancel').addEventListener('click', function() { modal.classList.add('hidden'); });
  modal.addEventListener('click', function(e) { if (e.target === modal) modal.classList.add('hidden'); });

  document.getElementById('modal-submit').addEventListener('click', async function() {
    var charId = charSelect.value;
    var count = parseInt(countInput.value, 10) || 10;
    var promptText = document.getElementById('modal-prompt').value.trim();
    // 프롬프트 저장
    if (promptText) savePrompt(charId, promptText);
    var btn = document.getElementById('modal-submit');
    btn.disabled = true; btn.textContent = '생성 중...';
    try {
      var payload = { charId: charId, count: count };
      if (promptText) payload.prompt = promptText;
      var res = await fetch('/api/characters/generate-candidates', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      var json = await res.json();
      if (json.success && json.jobId) {
        window.location.href = '/characters/candidates/' + json.jobId;
      } else {
        alert('생성 실패: ' + (json.error || '알 수 없는 오류'));
        btn.disabled = false; btn.textContent = '생성 시작';
      }
    } catch (err) {
      alert('요청 실패: ' + err.message);
      btn.disabled = false; btn.textContent = '생성 시작';
    }
  });

  loadCharacters();
})();
</script>
