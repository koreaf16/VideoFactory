<div>
  <!-- Header -->
  <div class="flex items-center justify-between mb-6">
    <div class="flex items-center gap-3">
      <a href="/pipeline" class="text-[#958da1] hover:text-white transition text-sm">&larr; 목록</a>
      <h2 class="text-3xl font-headline font-extrabold text-[#e5e1e4]">프로덕션 #<span id="run-id"><%= runId %></span></h2>
      <span id="stage-badge" class="text-[10px] font-semibold px-2.5 py-1 rounded-full"></span>
    </div>
    <button id="btn-advance" class="bg-[#7c3aed] hover:bg-[#6d28d9] text-white text-sm font-semibold px-5 py-2.5 rounded-lg transition opacity-50 cursor-not-allowed" disabled>다음 단계 &rarr;</button>
  </div>

  <!-- 파이프라인 스테이지 타임라인 -->
  <div class="bg-[#1b1b1d] rounded-xl border border-[#2a2a2c] p-6 mb-6">
    <h3 class="text-sm font-headline font-bold text-[#ccc3d8] mb-4">파이프라인 진행</h3>
    <div id="stage-timeline" class="flex items-center gap-1 overflow-x-auto pb-2"></div>
  </div>

  <!-- 현재 스테이지 안내 + 액션 -->
  <div id="stage-action" class="bg-[#1b1b1d] rounded-xl border border-[#2a2a2c] p-6 mb-6">
    <div id="action-content"></div>
  </div>

  <!-- 주인공 정보 -->
  <div id="protagonist-info" class="bg-[#1b1b1d] rounded-xl border border-[#2a2a2c] p-6 mb-6 hidden">
    <h3 class="text-sm font-headline font-bold text-[#ccc3d8] mb-3">주인공 프리셋</h3>
    <div id="preset-content" class="text-sm text-[#e5e1e4] space-y-1"></div>
  </div>

  <!-- 스텝 기록 -->
  <div class="bg-[#1b1b1d] rounded-xl border border-[#2a2a2c] p-6">
    <h3 class="text-sm font-headline font-bold text-[#ccc3d8] mb-3">단계 기록</h3>
    <div id="steps-list" class="space-y-2"></div>
  </div>
</div>

<script>
(function () {
  var runId = '<%= runId %>';
  var stagesConfig = [
    { key: 'protagonist_pending', label: '주인공 대기' },
    { key: 'protagonist_visual', label: '주인공 비주얼' },
    { key: 'script_pending', label: '대본 대기' },
    { key: 'episode_generating', label: '에피소드 생성' },
    { key: 'assets_creating', label: '자산 생성' },
    { key: 'snapshots_generating', label: '스냅샷 생성' },
    { key: 'completed', label: '완료' },
  ];
  var stageColors = {
    protagonist_pending: 'bg-yellow-500/20 text-yellow-400',
    protagonist_visual: 'bg-purple-500/20 text-purple-400',
    script_pending: 'bg-blue-500/20 text-blue-400',
    episode_generating: 'bg-cyan-500/20 text-cyan-400',
    assets_creating: 'bg-orange-500/20 text-orange-400',
    snapshots_generating: 'bg-teal-500/20 text-teal-400',
    completed: 'bg-green-500/20 text-green-400',
    failed: 'bg-red-500/20 text-red-400',
  };
  var stepStatusLabels = { pending: '대기', running: '진행중', completed: '완료', failed: '실패', skipped: '건너뜀' };

  function escapeHtml(str) {
    var div = document.createElement('div');
    div.textContent = str;
    return div.textContent;
  }

  function renderTimeline(currentStage) {
    var el = document.getElementById('stage-timeline');
    el.textContent = '';
    var currentIdx = stagesConfig.findIndex(function (s) { return s.key === currentStage; });

    stagesConfig.forEach(function (s, i) {
      var wrapper = document.createElement('div');
      wrapper.className = 'flex items-center gap-1';

      var col = document.createElement('div');
      col.className = 'flex flex-col items-center';

      var circle = document.createElement('div');
      if (i < currentIdx) circle.className = 'w-4 h-4 rounded-full bg-green-500';
      else if (i === currentIdx) circle.className = 'w-4 h-4 rounded-full bg-[#7c3aed] ring-2 ring-[#7c3aed]/40';
      else circle.className = 'w-4 h-4 rounded-full bg-[#353437]';

      var label = document.createElement('span');
      label.className = 'text-[10px] mt-1 whitespace-nowrap ' +
        (i < currentIdx ? 'text-green-400' : i === currentIdx ? 'text-[#d2bbff] font-semibold' : 'text-[#958da1]');
      label.textContent = s.label;

      col.appendChild(circle);
      col.appendChild(label);
      wrapper.appendChild(col);

      if (i < stagesConfig.length - 1) {
        var line = document.createElement('div');
        line.className = 'h-0.5 w-8 mt-[-12px] ' + (i < currentIdx ? 'bg-green-500' : 'bg-[#353437]');
        wrapper.appendChild(line);
      }
      el.appendChild(wrapper);
    });
  }

  function createLink(href, text, extraClass) {
    var a = document.createElement('a');
    a.href = href;
    a.className = 'inline-block bg-[#7c3aed] hover:bg-[#6d28d9] text-white text-sm font-semibold px-5 py-2 rounded-lg transition' + (extraClass ? ' ' + extraClass : '');
    a.textContent = text;
    return a;
  }

  function createNote(text) {
    var p = document.createElement('p');
    p.className = 'text-xs text-[#958da1] mt-2';
    p.textContent = text;
    return p;
  }

  function createCharIdInput() {
    var row = document.createElement('div');
    row.className = 'mt-3 flex gap-2';
    var inp = document.createElement('input');
    inp.id = 'inp-char-id';
    inp.type = 'text';
    inp.className = 'bg-[#131315] border border-[#4a4455] rounded-lg px-3 py-1.5 text-sm text-[#e5e1e4] outline-none';
    inp.placeholder = '캐릭터 ID 입력';
    var btn = document.createElement('button');
    btn.id = 'btn-set-protagonist';
    btn.className = 'bg-[#4a4455] hover:bg-[#5a5465] text-white text-sm px-4 py-1.5 rounded-lg transition';
    btn.textContent = '주인공 지정';
    row.appendChild(inp);
    row.appendChild(btn);
    return row;
  }

  function renderAction(run, presetStep) {
    var el = document.getElementById('action-content');
    el.textContent = '';
    var stage = run.currentStage;

    if (stage === 'protagonist_pending') {
      var preset = presetStep && presetStep.inputJson ? presetStep.inputJson : null;
      if (preset) {
        var msg = document.createElement('p');
        msg.className = 'text-sm text-[#e5e1e4] mb-3';
        msg.textContent = '주인공 프리셋이 준비되었습니다. 캐릭터를 생성하세요.';
        el.appendChild(msg);

        var params = encodeURIComponent(JSON.stringify(preset));
        el.appendChild(createLink('/characters?preset=' + params, '캐릭터 생성 페이지로 이동'));
        el.appendChild(createNote('캐릭터를 생성한 후, 아래에서 주인공을 지정하세요.'));
        el.appendChild(createCharIdInput());
      } else {
        var p = document.createElement('p');
        p.className = 'text-sm text-[#e5e1e4]';
        p.textContent = '주인공 캐릭터를 먼저 생성하세요.';
        el.appendChild(p);
      }
    } else if (stage === 'protagonist_visual') {
      var p2 = document.createElement('p');
      p2.className = 'text-sm text-[#e5e1e4] mb-3';
      p2.textContent = '주인공의 앵커 이미지 -> 파생 이미지 -> LoRA 학습을 완료하세요.';
      el.appendChild(p2);
      if (run.protagonistId) {
        el.appendChild(createLink('/characters', '캐릭터 관리로 이동'));
        el.appendChild(createNote('주인공 ID: ' + run.protagonistId + ' - LoRA가 등록되면 다음 단계로 진행 가능'));
      }
    } else if (stage === 'script_pending') {
      var p3 = document.createElement('p');
      p3.className = 'text-sm text-[#e5e1e4] mb-3';
      p3.textContent = '마스터 대본을 생성하고 연결하세요.';
      el.appendChild(p3);
      el.appendChild(createLink('/scripts', '마스터 대본으로 이동', 'mr-3'));

      var row = document.createElement('div');
      row.className = 'mt-3 flex gap-2';
      var inp = document.createElement('input');
      inp.id = 'inp-script-id';
      inp.type = 'number';
      inp.className = 'bg-[#131315] border border-[#4a4455] rounded-lg px-3 py-1.5 text-sm text-[#e5e1e4] outline-none w-32';
      inp.placeholder = 'Script ID';
      var btn = document.createElement('button');
      btn.id = 'btn-set-script';
      btn.className = 'bg-[#4a4455] hover:bg-[#5a5465] text-white text-sm px-4 py-1.5 rounded-lg transition';
      btn.textContent = '대본 연결';
      row.appendChild(inp);
      row.appendChild(btn);
      el.appendChild(row);
    } else if (stage === 'episode_generating') {
      var p4 = document.createElement('p');
      p4.className = 'text-sm text-[#e5e1e4]';
      p4.textContent = '에피소드를 생성하세요. (현재 EP: ' + run.currentEpNum + ')';
      el.appendChild(p4);
      el.appendChild(createLink('/episodes/new', '에피소드 생성으로 이동'));
    } else if (stage === 'assets_creating') {
      var p5 = document.createElement('p');
      p5.className = 'text-sm text-[#e5e1e4]';
      p5.textContent = '에피소드에 필요한 캐릭터와 장소를 생성하세요.';
      el.appendChild(p5);
    } else if (stage === 'snapshots_generating') {
      var p6 = document.createElement('p');
      p6.className = 'text-sm text-[#e5e1e4]';
      p6.textContent = '씬별 스냅샷 이미지를 생성하세요.';
      el.appendChild(p6);
    } else if (stage === 'completed') {
      var p7 = document.createElement('p');
      p7.className = 'text-sm text-green-400 font-semibold';
      p7.textContent = '파이프라인이 완료되었습니다.';
      el.appendChild(p7);
    } else if (stage === 'failed') {
      var p8 = document.createElement('p');
      p8.className = 'text-sm text-red-400';
      p8.textContent = '오류: ' + (run.errorMessage || '알 수 없음');
      el.appendChild(p8);
    }

    // Bind buttons
    var btnProt = document.getElementById('btn-set-protagonist');
    if (btnProt) {
      btnProt.onclick = function () {
        var charId = document.getElementById('inp-char-id').value.trim();
        if (!charId) return;
        fetch('/api/pipeline/runs/' + runId + '/protagonist', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ protagonistId: charId }),
        }).then(function (r) { return r.json(); }).then(function (json) {
          if (json.success) location.reload();
          else window.showToast && showToast(json.error, 'error');
        });
      };
    }

    var btnScript = document.getElementById('btn-set-script');
    if (btnScript) {
      btnScript.onclick = function () {
        var scriptId = Number(document.getElementById('inp-script-id').value);
        if (!scriptId) return;
        fetch('/api/pipeline/runs/' + runId + '/script', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ scriptId: scriptId }),
        }).then(function (r) { return r.json(); }).then(function (json) {
          if (json.success) location.reload();
          else window.showToast && showToast(json.error, 'error');
        });
      };
    }
  }

  function renderPreset(steps) {
    var presetStep = steps.find(function (s) { return s.stepType === 'protagonist_preset'; });
    if (!presetStep || !presetStep.inputJson) return null;
    var data = presetStep.inputJson;
    var el = document.getElementById('preset-content');
    el.textContent = '';
    var fields = [
      ['이름', data.name], ['영문', data.nameEn], ['역할', data.role],
      ['외모', data.appearance], ['성격', data.profile], ['프롬프트', data.promptBase],
    ];
    fields.forEach(function (f) {
      if (!f[1]) return;
      var div = document.createElement('div');
      var lbl = document.createElement('span');
      lbl.className = 'text-[#958da1]';
      lbl.textContent = f[0] + ': ';
      div.appendChild(lbl);
      div.appendChild(document.createTextNode(f[1]));
      el.appendChild(div);
    });
    document.getElementById('protagonist-info').classList.remove('hidden');
    return presetStep;
  }

  function renderSteps(steps) {
    var el = document.getElementById('steps-list');
    el.textContent = '';
    if (!steps.length) {
      var p = document.createElement('p');
      p.className = 'text-xs text-[#958da1]';
      p.textContent = '기록 없음';
      el.appendChild(p);
      return;
    }
    steps.forEach(function (s) {
      var row = document.createElement('div');
      row.className = 'flex items-center justify-between text-xs py-1 border-b border-[#2a2a2c]';
      var name = document.createElement('span');
      name.className = 'text-[#e5e1e4]';
      name.textContent = s.stepType;
      var status = document.createElement('span');
      status.className = s.stepStatus === 'completed' ? 'text-green-400' : s.stepStatus === 'failed' ? 'text-red-400' : s.stepStatus === 'running' ? 'text-cyan-400' : 'text-[#958da1]';
      status.textContent = stepStatusLabels[s.stepStatus] || s.stepStatus;
      row.appendChild(name);
      row.appendChild(status);
      el.appendChild(row);
    });
  }

  // Load data
  fetch('/api/pipeline/runs/' + runId)
    .then(function (r) { return r.json(); })
    .then(function (json) {
      if (!json.success) {
        var el = document.getElementById('action-content');
        var p = document.createElement('p');
        p.className = 'text-red-400';
        p.textContent = '로드 실패: ' + (json.error || '');
        el.appendChild(p);
        return;
      }
      var run = json.data.run;
      var steps = json.data.steps;

      // Badge
      var badge = document.getElementById('stage-badge');
      var stageConf = stagesConfig.find(function (s) { return s.key === run.currentStage; });
      badge.textContent = stageConf ? stageConf.label : run.currentStage;
      badge.className = 'text-[10px] font-semibold px-2.5 py-1 rounded-full ' + (stageColors[run.currentStage] || 'bg-gray-500/20 text-gray-400');

      renderTimeline(run.currentStage);
      var presetStep = renderPreset(steps);
      renderAction(run, presetStep);
      renderSteps(steps);

      var btnAdv = document.getElementById('btn-advance');
      if (run.currentStage === 'completed' || run.currentStage === 'failed') {
        btnAdv.classList.add('hidden');
      } else {
        // 데이터 로드 완료 후 버튼 활성화
        btnAdv.disabled = false;
        btnAdv.classList.remove('opacity-50', 'cursor-not-allowed');
      }
    });

  // Advance button
  document.getElementById('btn-advance').onclick = function () {
    fetch('/api/pipeline/runs/' + runId + '/advance', { method: 'POST' })
      .then(function (r) { return r.json(); })
      .then(function (json) {
        if (json.success) {
          window.showToast && showToast(json.data.message, 'success');
          setTimeout(function () { location.reload(); }, 500);
        } else {
          window.showToast && showToast(json.error || '진행 실패', 'error');
        }
      });
  };
}());
</script>
